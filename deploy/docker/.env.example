# Copia questo file in ".env" (cp .env.example .env), compilalo e proteggilo: chmod 600 .env
# Non metterlo su GitHub e non condividerlo: contiene le password.

# Porta a cui si collegano i client: http://IP-DEL-SERVER:8082
HTTP_PORT=8082

# Password dell'utente "root" del database (serve solo agli amministratori, non all'applicazione)
MYSQL_ROOT_PASSWORD=

# Password dell'utente "servizi" con cui l'applicazione si collega al database
DB_PASSWORD=

# Segreto per firmare i token di accesso: almeno 32 caratteri casuali (se è corto l'applicazione non parte)
JWT_SECRET=

# Primo amministratore: creato solo al primo avvio, password di almeno 10 caratteri. Cambiala subito dopo il primo accesso.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Versione di MySQL. 8.4 è la LTS (supportata a lungo): consigliata in produzione.
# Cambiala solo se sai cosa fai: un database creato con una versione non torna indietro.
MYSQL_IMAGE=mysql:8.4

# Per generare valori casuali:   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
